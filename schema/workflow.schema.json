{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/HiAriesZhou/awesome-workflow/schema/workflow.schema.json",
  "title": "Awesome Workflow Entry",
  "type": "object",
  "required": [
    "id",
    "title",
    "summary",
    "domain",
    "maturity",
    "tools",
    "steps",
    "sources",
    "added",
    "verified"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "description": "Stable kebab-case id; filename should match id.yml"
    },
    "title": { "type": "string", "minLength": 3, "maxLength": 120 },
    "summary": { "type": "string", "minLength": 20, "maxLength": 400 },
    "domain": {
      "type": "string",
      "enum": ["ai-coding", "agent-engineering", "repo-ops", "research", "design-review", "other"]
    },
    "maturity": {
      "type": "string",
      "enum": ["draft", "verified", "archived"]
    },
    "tools": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "claude-code",
          "codex",
          "cursor",
          "grok",
          "github-actions",
          "n8n",
          "playwright",
          "mcp",
          "skills",
          "other"
        ]
      }
    },
    "model_tiers": {
      "type": "array",
      "items": { "type": "string", "enum": ["premium", "standard", "cheap", "unknown"] },
      "default": ["unknown"]
    },
    "automation": {
      "type": "string",
      "enum": ["manual", "assisted", "semi-auto", "automated"],
      "description": "How much of the loop runs without a human"
    },
    "authors": {
      "type": "array",
      "items": { "type": "string" }
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" }
    },
    "not_for": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Anti-examples / when not to use"
    },
    "steps": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["id", "name", "actor"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "actor": {
            "type": "string",
            "enum": ["human", "agent", "tool", "ci"]
          },
          "human_gate": { "type": "boolean", "default": false },
          "model_tier": {
            "type": "string",
            "enum": ["premium", "standard", "cheap", "unknown"]
          },
          "inputs": { "type": "array", "items": { "type": "string" } },
          "outputs": { "type": "array", "items": { "type": "string" } },
          "notes": { "type": "string" },
          "evidence_url": { "type": "string", "format": "uri" }
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["label", "url"],
        "additionalProperties": false,
        "properties": {
          "label": { "type": "string" },
          "url": { "type": "string", "format": "uri" },
          "stars": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "added": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "verified": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
  }
}
