{
  "name": "awesome-workflow",
  "version": "0.1.0",
  "private": true,
  "description": "Curated interactive library of real-world AI agent & coding workflows",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "build:data": "node scripts/build.mjs",
    "dev": "npm run build:data && vite --strictPort",
    "build": "npm run build:data && tsc --noEmit && tsc -p tsconfig.node.json && vite build",
    "preview": "vite preview",
    "test": "node --test scripts/diagram/compile.test.mjs scripts/workflow.test.mjs scripts/curator/pipeline.test.mjs",
    "check": "npm run build:data && npm test && tsc --noEmit --pretty false && tsc -p tsconfig.node.json --pretty false",
    "curate": "node scripts/curator/cli.mjs",
    "test:visual": "node scripts/diagram/visual-check.mjs",
    "test:gallery": "node scripts/gallery-check.mjs",
    "test:preview": "node scripts/preview-check.mjs"
  },
  "dependencies": {
    "parse5": "7.3.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "undici": "7.30.0",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "playwright": "1.58.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.5"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
